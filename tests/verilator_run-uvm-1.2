#!/bin/bash
rm -rf out.log
touch out.log

# Limit CPU and memory usage so the system isn't swamped and unresponsive.
# Assumes Hyperthreading (divide-by-two).
# Leaves one CPU free (minus one) to keep the system responsive.
# 8 threads -> 3 jobs; never below 1
jobs=$(( $(nproc) / 2 - 1 ))
(( jobs < 1 )) && jobs=1

function vrltr {
    nice -n 15 ionice -c 3 verilator \
        -Wno-fatal \
        --binary \
        --fourstate \
        -j $jobs \
        -MAKEFLAGS 'OBJCACHE=ccache' \
        -CFLAGS -O0 \
        --top-module unit_test_run_module \
        +incdir+../ \
        +incdir+../uvm_unit-uvm-1.2/src \
        +define+UVM_NO_DPI \
        +define+UVM_NO_RELNOTES \
        "$@" \
    && \
    ./obj_dir/Vunit_test_run_module \
        +uvm_unit_log_file=out.log
}

function vrltr_no_uvm {
    nice -n 15 ionice -c 3 verilator \
        -Wno-fatal \
        --binary \
        --fourstate \
        -j $jobs \
        -MAKEFLAGS 'OBJCACHE=ccache' \
        -CFLAGS -O0 \
        --top-module unit_test_run_module \
        +incdir+../ \
        "$@" \
    && \
    ./obj_dir/Vunit_test_run_module \
        +uvm_unit_log_file=out.log
}

vrltr fixtures_and_assertions_test.sv second_file_test.sv

vrltr passing_test.sv
EXIT_CODE=$?
if (( $EXIT_CODE != 0 )); then
    echo "FAILED - passing test should have passing exit code ($EXIT_CODE)";
    exit 1;
fi

vrltr empty_test.sv
if (( $? != 0 )); then
    echo "FAILED - passing empty test should have passing exit code";
    exit 1;
fi

vrltr one_error_test.sv
if (( $? == 0 )); then
    echo "FAILED - failing test should have failing exit code";
    exit 1;
fi

vrltr uvm_warning_error_fatal_test.sv
vrltr unit_test_run_module_body_test.sv
vrltr run_phases_test.sv
vrltr timeout_test.sv
vrltr sv_test_and_uvm_unit_test.sv

## The module test includes only mod_unit.svh, which should not require UVM
vrltr_no_uvm rtl_test.sv
vrltr_no_uvm sv_function_test.sv
vrltr_no_uvm game_of_life_test.sv
vrltr_no_uvm property_test.sv

rm -rf obj_dir/

diff -s out.log expected-verilator-uvm-1.2.log && echo "PASSED" || echo "FAILED"
